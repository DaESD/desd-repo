  "components": [
    {
      "text": "# Login Form",
      "type": "text",
      "layout": {
        "row": "Row_0y4z0x8",
        "columns": null
      },
      "id": "Field_1mcbqa7"
    },
    {
      "type": "separator",
      "layout": {
        "row": "Row_19eu3rj",
        "columns": null
      },
      "id": "Field_1h2o2kx"
    },
    {
      "label": "I want to register as:",
      "values": [
        {
          "label": "Producer",
          "value": "producer"
        },
        {
          "label": "Customer",
          "value": "customer"
        }
      ],
      "type": "radio",
      "layout": {
        "row": "Row_1w7wadi",
        "columns": null
      },
      "id": "Field_16zxwk4",
      "key": "prod_cust"
    },
    {
      "label": "First Name",
      "type": "textfield",
      "layout": {
        "row": "Row_02qre8i",
        "columns": null
      },
      "id": "Field_0amqmiq",
      "key": "first_name",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Last Name",
      "type": "textfield",
      "layout": {
        "row": "Row_02qre8i",
        "columns": null
      },
      "id": "Field_0vfw75b",
      "key": "last_name",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Email",
      "type": "textfield",
      "layout": {
        "row": "Row_1cbfcv9",
        "columns": null
      },
      "id": "Field_13g24gm",
      "key": "email",
      "validate": {
        "validationType": "email",
        "required": true
      }
    },
    {
      "label": "Phone Number",
      "type": "textfield",
      "layout": {
        "row": "Row_1vecyx4",
        "columns": null
      },
      "id": "Field_1hl7c2n",
      "key": "phone_number",
      "validate": {
        "required": true,
        "validationType": "phone"
      }
    },
    {
      "subtype": "date",
      "dateLabel": "Date of Birth",
      "type": "datetime",
      "layout": {
        "row": "Row_16kd6fe",
        "columns": null
      },
      "id": "Field_1m9wj4u",
      "key": "birthday",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Address",
