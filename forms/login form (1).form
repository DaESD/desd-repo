      "layout": {
        "row": "Row_16ucixh",
        "columns": null
      },
      "id": "Field_05nae7v",
      "key": "address"
    },
    {
      "label": "Upload Business Document",
      "type": "filepicker",
      "layout": {
        "row": "Row_0b20we6",
        "columns": null
      },
      "id": "Field_094jlpa",
      "key": "producer_upload",
      "validate": {
        "required": true
      },
      "conditional": {
        "hide": "=prod_cust != \"producer\""
      }
    },
    {
      "type": "separator",
      "layout": {
