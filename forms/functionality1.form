{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "ffa1f04"
  },
  "schemaVersion": 19,
  "id": "Form_Func1",
  "components": [
    {
      "text": "# Publish Product to Marketplace \nThis form is for entering information about the product you want to publish to our marketplace. If your product is organic, you will need to upload the organic certification which will then be sent to an external service to be verified.\n",
      "type": "text",
      "layout": {
        "row": "Row_0w6pmei",
        "columns": null
      },
      "id": "Field_0vw08c2",
      "properties": { }
    },
    {
      "type": "separator",
      "layout": {
        "row": "Row_0ga30cs",
        "columns": null
      },
      "id": "Field_0fbau8g"
    },
    {
      "text": "### Product Details",
      "type": "text",
      "layout": {
        "row": "Row_0lvvh91",
        "columns": null
      },
      "id": "Field_0tx647p"
    },
    {
      "text": "Upload Product Image",
      "type": "text",
      "layout": {
        "row": "Row_142x2ni",
        "columns": null
      },
      "id": "Field_1je81id"
    },
    {
      "type": "image",
      "layout": {
        "row": "Row_0z3ica6",
        "columns": null
      },
      "id": "Field_1s4ws3d"
    },
    {
      "label": "Upload Image",
      "type": "filepicker",
      "layout": {
        "row": "Row_1mcrtd3",
        "columns": null
      },
      "id": "Field_02xa2pl",
      "key": "product_image"
    },
    {
      "label": "Product Name",
      "type": "textfield",
      "layout": {
        "row": "Row_0dahdm7",
        "columns": null
      },
      "id": "Field_0yqztdc",
      "key": "Product_name",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Price",
      "type": "number",
      "layout": {
        "row": "Row_0dahdm7",
        "columns": 6
      },
      "id": "Field_11k7wz0",
      "key": "price",
      "increment": "0.01",
      "validate": {
        "required": true,
        "min": "0.01"
      }
    },
    {
      "label": "Weight",
      "type": "number",
      "layout": {
        "row": "Row_0d5savs",
        "columns": null
      },
      "id": "Field_082o3t0",
      "key": "Weight",
      "increment": "0.01",
      "validate": {
        "required": true,
        "min": "0.01"
      }
    },
    {
      "label": "Category",
      "values": [
        {
          "label": "Vegetable",
          "value": "vegetable"
        },
        {
          "label": "Fruit",
          "value": "fruit"
        },
        {
          "label": "Grocery",
          "value": "Grocery"
        }
      ],
      "type": "select",
      "layout": {
        "row": "Row_0cqjs66",
        "columns": null
      },
      "id": "Field_0dbcp2i",
      "key": "Product_category",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Product Description",
      "type": "textarea",
      "layout": {
        "row": "Row_1yxw1rd",
        "columns": null
      },
      "id": "Field_1dt6qpd",
      "key": "product_description",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Available Quantity",
      "type": "number",
      "layout": {
        "row": "Row_0s2tdxg",
        "columns": 4
      },
      "id": "Field_0doox2w",
      "key": "quantity",
      "defaultValue": 0,
      "increment": "1",
      "validate": {
        "required": true,
        "min": "1"
      }
    },
    {
      "subtype": "date",
      "dateLabel": "Availability Period From:",
      "type": "datetime",
      "layout": {
        "row": "Row_0s2tdxg",
        "columns": null
      },
      "id": "Field_06akc82",
      "key": "start_date",
      "validate": {
        "required": true
      },
      "disallowPassedDates": true
    },
    {
      "subtype": "date",
      "dateLabel": "To:",
      "type": "datetime",
      "layout": {
        "row": "Row_0s2tdxg",
        "columns": null
      },
      "id": "Field_03ml6uw",
      "key": "end_date",
      "validate": {
        "required": true
      }
    },
    {
      "text": "### General Product Information",
      "type": "text",
      "layout": {
        "row": "Row_029i635",
        "columns": null
      },
      "id": "Field_0k0og10",
      "properties": {
        "key1": "value"
      }
    },
    {
      "subtype": "date",
      "dateLabel": "Harvest Date",
      "type": "datetime",
      "layout": {
        "row": "Row_0rbhpqv",
        "columns": null
      },
      "id": "Field_0xwat1p",
      "key": "harvest_date"
    },
    {
      "subtype": "date",
      "dateLabel": "Best Before Date",
      "type": "datetime",
      "layout": {
        "row": "Row_0rbhpqv",
        "columns": null
      },
      "id": "Field_0d3onn4",
      "key": "bestbefore_date"
    },
    {
      "label": "Allergen Details",
      "values": [
        {
          "label": "Dairy",
          "value": "Dairy"
        },
        {
          "label": "Eggs",
          "value": "Eggs"
        },
        {
          "label": "Nuts",
          "value": "Nuts"
        },
        {
          "label": "Soy",
          "value": "Soy"
        },
        {
          "label": "Wheat",
          "value": "Wheat"
        },
        {
          "label": "Gluten",
          "value": "Gluten"
        },
        {
          "label": "Celery",
          "value": "Celery"
        },
        {
          "label": "Mustard",
          "value": "Mustard"
        },
        {
          "label": "Fish",
          "value": "Fish"
        },
        {
          "label": "Sesame",
          "value": "Sesame"
        },
        {
          "label": "Shellfish",
          "value": "Shellfish"
        },
        {
          "label": "No allergens",
          "value": "N/A"
        },
        {
          "label": "Other",
          "value": "Other"
        }
      ],
      "type": "checklist",
      "layout": {
        "row": "Row_1jjy4r2",
        "columns": null
      },
      "id": "Field_0nts4sb",
      "key": "allergies",
      "validate": {
        "required": true
      },
      "conditional": {
        "hide": "=(not(list contains(allergies, \"N/A\")) or count(allergies) = 1) and (not(list contains(allergies, \"Other\")) or (otherallergen != null and otherallergen != \"\"))"
      }
    },
    {
      "label": "Enter Other Allergen",
      "type": "textfield",
      "layout": {
        "row": "Row_0b01yq5",
        "columns": null
      },
      "id": "Field_0dxnkak",
      "key": "otherallergen",
      "conditional": {
        "hide": "==not(list contains(allergies, \"Other\"))"
      },
      "validate": {
        "pattern": "\"conditional\": {  \"hide\": \"=not(list contains(allergies, \\\"Other\\\"))\"}"
      },
      "properties": { }
    },
    {
      "label": "Farm Origin",
      "type": "textfield",
      "layout": {
        "row": "Row_1hqpwv3",
        "columns": null
      },
      "id": "Field_1b61ucl",
      "key": "farm_origin",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Organic Certification Available?",
      "type": "checkbox",
      "layout": {
        "row": "Row_17q9wzf",
        "columns": null
      },
      "id": "Field_05q0gt8",
      "key": "organic_check"
    },
    {
      "label": "Organic Certificate Number",
      "type": "textfield",
      "layout": {
        "row": "Row_13nvmmj",
        "columns": null
      },
      "id": "Field_0rf33si",
      "key": "certificate_number",
      "validate": {
        "required": true
      },
      "conditional": {
        "hide": "=organic_check != true"
      }
    },
    {
      "label": "Upload Organic Certificate",
      "type": "filepicker",
      "layout": {
        "row": "Row_1fogrcf",
        "columns": null
      },
      "id": "Field_08xxvvz",
      "key": "fileupload",
      "validate": {
        "required": false
      },
      "conditional": {
        "hide": "=organic_check != true"
      }
    },
    {
      "label": "Submit",
      "action": "submit",
      "type": "button",
      "layout": {
        "row": "Row_1tek0r7",
        "columns": null
      },
      "id": "Field_124pmso"
    },
    {
      "type": "separator",
      "layout": {
        "row": "Row_1tja52i",
        "columns": null
      },
      "id": "Field_03ed8od"
    }
  ],
  "type": "default"
}
