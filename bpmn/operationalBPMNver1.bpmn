<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_UC1_Combined" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="64767e4" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:collaboration id="Collaboration_UC1_Combined" name="Producer Product Listing and Inventory Management">
    <bpmn:extensionElements />
    <bpmn:participant id="Participant_Producer" name="Local Food Producer" processRef="Process_Producer" />
    <bpmn:participant id="Participant_Marketplace" name="Bristol Regional Food Network" processRef="Process_Marketplace" />
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer" />
    <bpmn:participant id="Participant_ExternalOrganic" name="External Organic Verification Service" processRef="Process_ExternalOrganic" />
    <bpmn:messageFlow id="MsgFlow_SubmitListing" sourceRef="Task_Prod_SubmitListing" targetRef="StartEvent_Sys_ListingReceived" />
    <bpmn:messageFlow id="MsgFlow_ValidationErrors" sourceRef="Task_Sys_DisplayErrors" targetRef="Event_Prod_ReceiveErrors" />
    <bpmn:messageFlow id="MsgFlow_VerifyRequest" sourceRef="Task_Sys_SendVerifyReq" targetRef="StartEvent_Ext_ReceiveReq" />
    <bpmn:messageFlow id="MsgFlow_VerifyResponse" sourceRef="EndEvent_Ext_Success" targetRef="Event_1y0dlrk" />
    <bpmn:messageFlow id="MsgFlow_VerifyTimeout" sourceRef="EndEvent_Ext_Error" targetRef="Event_1y0dlrk" />
    <bpmn:messageFlow id="MsgFlow_BrowseStore" sourceRef="Task_Cust_SearchView" targetRef="Task_Sys_IndexPublish" />
    <bpmn:messageFlow id="MsgFlow_PlaceOrder" sourceRef="Task_Cust_Checkout" targetRef="Event_Sys_OrderPlaced" />
    <bpmn:messageFlow id="MsgFlow_NotifyDepleted" sourceRef="Task_Notif_SendDepleted" targetRef="Event_Prod_ReceiveDepleted" />
    <bpmn:messageFlow id="MsgFlow_NotifyReactivated" sourceRef="Task_Notif_SendReactivated" targetRef="Event_Prod_ReceiveReactivated" />
    <bpmn:messageFlow id="MsgFlow_NotifyRejected" sourceRef="Task_Notif_SendRejected" targetRef="Event_Prod_ReceiveStatus" />
    <bpmn:messageFlow id="MsgFlow_NotifyListed" sourceRef="Task_Notif_SendListed" targetRef="Event_Prod_ReceiveStatus" />
    <bpmn:messageFlow id="Flow_1pr7gix" sourceRef="Activity_1ci1h43" targetRef="Event_Sys_StockUpdateReceived" />
    <bpmn:messageFlow id="Flow_1rttjwc" sourceRef="Activity_0kojleu" targetRef="Event_Sys_StockUpdateReceived" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Producer" name="Local Food Producer Process" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Prod" name="Log in &#38; open Product Management">
      <bpmn:outgoing>Flow_P1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Prod_EnterDetails" name="Enter product details, dates, allergens, storage &#38; organic claim">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_Func1" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_P1</bpmn:incoming>
      <bpmn:incoming>Flow_P4</bpmn:incoming>
      <bpmn:outgoing>Flow_P2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_Prod_SubmitListing" name="Submit product listing request">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="submit-product-listing" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_P2</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_Prod_ReceiveErrors" name="Receive missing fields validation error">
      <bpmn:incoming>Flow_0xpkiau</bpmn:incoming>
      <bpmn:outgoing>Flow_P4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_P_Err" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_1obysxn" name="Await listing response">
      <bpmn:outgoing>Flow_P3</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0ocrv1z" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_15ypxv5" name="Validation error?">
      <bpmn:incoming>Flow_P3</bpmn:incoming>
      <bpmn:outgoing>Flow_0vwgx6y</bpmn:outgoing>
      <bpmn:outgoing>Flow_0xpkiau</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_Prod_ReceiveStatus" name="Receive listing status notification">
      <bpmn:incoming>Flow_0vwgx6y</bpmn:incoming>
      <bpmn:outgoing>Flow_P5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_P_Stat" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_Prod_ReceiveDepleted" name="Receive Stock Depleted email">
      <bpmn:incoming>Flow_P5</bpmn:incoming>
      <bpmn:outgoing>Flow_P6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_P_Dep" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_Prod_EnterStock" name="Log into inventory panel">
      <bpmn:incoming>Flow_P6</bpmn:incoming>
      <bpmn:outgoing>Flow_0r3x0wt</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_16okqx6" name="Add additional stock?">
      <bpmn:incoming>Flow_0r3x0wt</bpmn:incoming>
      <bpmn:outgoing>Flow_0bt2xoh</bpmn:outgoing>
      <bpmn:outgoing>Flow_0kpujsc</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_1ci1h43" name="Dismiss depleted/ restock notification">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0bt2xoh</bpmn:incoming>
      <bpmn:outgoing>Flow_1yj1rgi</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_0kojleu" name="Submit stock replenishment form">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_Func2" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0kpujsc</bpmn:incoming>
      <bpmn:outgoing>Flow_1yagte2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Prod" name="Listing &#38; stock cycle complete">
      <bpmn:incoming>Flow_P9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Event_Prod_ReceiveReactivated" name="Receive reactivation / status update">
      <bpmn:incoming>Flow_1yagte2</bpmn:incoming>
      <bpmn:incoming>Flow_1yj1rgi</bpmn:incoming>
      <bpmn:outgoing>Flow_P9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_P_React" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_P1" sourceRef="StartEvent_Prod" targetRef="Task_Prod_EnterDetails" />
    <bpmn:sequenceFlow id="Flow_P4" sourceRef="Event_Prod_ReceiveErrors" targetRef="Task_Prod_EnterDetails" />
    <bpmn:sequenceFlow id="Flow_P2" sourceRef="Task_Prod_EnterDetails" targetRef="Task_Prod_SubmitListing" />
    <bpmn:sequenceFlow id="Flow_0xpkiau" name="Yes" sourceRef="Gateway_15ypxv5" targetRef="Event_Prod_ReceiveErrors" />
    <bpmn:sequenceFlow id="Flow_P3" sourceRef="Event_1obysxn" targetRef="Gateway_15ypxv5" />
    <bpmn:sequenceFlow id="Flow_0vwgx6y" name="No" sourceRef="Gateway_15ypxv5" targetRef="Event_Prod_ReceiveStatus" />
    <bpmn:sequenceFlow id="Flow_P5" sourceRef="Event_Prod_ReceiveStatus" targetRef="Event_Prod_ReceiveDepleted" />
    <bpmn:sequenceFlow id="Flow_P6" sourceRef="Event_Prod_ReceiveDepleted" targetRef="Task_Prod_EnterStock" />
    <bpmn:sequenceFlow id="Flow_0r3x0wt" sourceRef="Task_Prod_EnterStock" targetRef="Gateway_16okqx6" />
    <bpmn:sequenceFlow id="Flow_0bt2xoh" name="No" sourceRef="Gateway_16okqx6" targetRef="Activity_1ci1h43" />
    <bpmn:sequenceFlow id="Flow_0kpujsc" name="Yes" sourceRef="Gateway_16okqx6" targetRef="Activity_0kojleu" />
    <bpmn:sequenceFlow id="Flow_1yj1rgi" sourceRef="Activity_1ci1h43" targetRef="Event_Prod_ReceiveReactivated" />
    <bpmn:sequenceFlow id="Flow_1yagte2" sourceRef="Activity_0kojleu" targetRef="Event_Prod_ReceiveReactivated" />
    <bpmn:sequenceFlow id="Flow_P9" sourceRef="Event_Prod_ReceiveReactivated" targetRef="EndEvent_Prod" />
  </bpmn:process>
  <bpmn:process id="Process_Marketplace" name="Bristol Regional Food Network System" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Marketplace">
      <bpmn:lane id="Lane_Notifications" name="Notification Service">
        <bpmn:flowNodeRef>Task_Notif_SendRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Sys_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notif_SendListed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Sys_SeasonEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notif_SendDepleted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notif_SendReactivated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Sys_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_StockMgmt" name="Stock Management">
        <bpmn:flowNodeRef>Gateway_0b8uggz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Sys_StockUpdateReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Stk_SetUnavailableInit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Stk_SetOutOfStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Stk_ZeroCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Stk_Decrement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Sys_OrderPlaced</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Stk_SetAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Stk_InitialCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Stk_SeasonEndCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Stk_Reactivate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Stk_SetSeasonExpired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0swcidw</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admin" name="Marketplace Admin">
        <bpmn:flowNodeRef>Gateway_Admin_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Admin_ManualReview</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CoreSystem" name="Main Marketplace System">
        <bpmn:flowNodeRef>Task_Sys_SendVerifyReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sys_WriteRecord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Sys_OrganicClaimed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sys_IndexPublish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Sys_ValidData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sys_DisplayErrors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sys_ValidatePayload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_Sys_ListingReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_1y0dlrk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1q1iina</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Sys_CertApproved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:exclusiveGateway id="Gateway_0b8uggz" name="Restock form submitted?">
      <bpmn:incoming>Flow_Stk6</bpmn:incoming>
      <bpmn:outgoing>Flow_13b86jj</bpmn:outgoing>
      <bpmn:outgoing>Flow_1mhj75h</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_Sys_StockUpdateReceived" name="Receive stock update">
      <bpmn:incoming>Flow_N2</bpmn:incoming>
      <bpmn:outgoing>Flow_Stk6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_S_Replenish" messageRef="Message_32r4vlk" />
    </bpmn:intermediateCatchEvent>
    <bpmn:dataStoreReference id="DataStore_CoreDB" name="Product &#38; Inventory Database" />
    <bpmn:sendTask id="Task_Sys_SendVerifyReq" name="Contact external organic verification service">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="request-organic-verification" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S_YesOrganic</bpmn:incoming>
      <bpmn:outgoing>Flow_11czauv</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_Admin_Approved" name="Admin approves organic check?">
      <bpmn:incoming>Flow_A1</bpmn:incoming>
      <bpmn:outgoing>Flow_A_Pass</bpmn:outgoing>
      <bpmn:outgoing>Flow_A_Fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Stk_SetUnavailableInit" name="Set initial status to Unavailable">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="set-product-unavailable" />
        <zeebe:ioMapping>
          <zeebe:input source="=productId" target="productId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Stk_InitNo</bpmn:incoming>
      <bpmn:outgoing>Flow_Stk2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Sys_WriteRecord" name="Update organic status &#38; add product record to DB">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update-product-record" />
        <zeebe:ioMapping>
          <zeebe:input source="=productId" target="productId" />
          <zeebe:input source="=certificationValid" target="ceritifcationValid" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S_NoOrganic</bpmn:incoming>
      <bpmn:incoming>Flow_A_Pass</bpmn:incoming>
      <bpmn:incoming>Flow_S_ApiPass</bpmn:incoming>
      <bpmn:outgoing>Flow_S5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataAssoc_Write">
        <bpmn:targetRef>DataStore_CoreDB</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Stk_SetOutOfStock" name="Set status Unavailable (Out of Stock) &#38; hide from store">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mark-out-of-stock" />
        <zeebe:ioMapping>
          <zeebe:input source="=productId" target="productId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Stk_IsZero</bpmn:incoming>
      <bpmn:outgoing>Flow_Stk5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Sys_OrganicClaimed" name="Organic certification claimed?">
      <bpmn:incoming>Flow_S_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_S_NoOrganic</bpmn:outgoing>
      <bpmn:outgoing>Flow_S_YesOrganic</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Sys_IndexPublish" name="Publish product to store">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-product" />
        <zeebe:ioMapping>
          <zeebe:input source="=productId" target="productId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Stk1</bpmn:incoming>
      <bpmn:incoming>Flow_Stk2</bpmn:incoming>
      <bpmn:outgoing>Flow_S6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Admin_ManualReview" name="Review uploaded organic certificate against farm records">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_OrganicVerification" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0myujez</bpmn:incoming>
      <bpmn:outgoing>Flow_A1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Sys_ValidData" name="All mandatory fields valid?">
      <bpmn:incoming>Flow_S2</bpmn:incoming>
      <bpmn:outgoing>Flow_S_Invalid</bpmn:outgoing>
      <bpmn:outgoing>Flow_S_Valid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_Sys_DisplayErrors" name="Flag missing fields &#38; send missing information error">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-validation-error" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S_Invalid</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_Sys_ValidatePayload" name="Validate mandatory fields &#38; numeric constraints">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-product-information" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=price" target="price" />
          <zeebe:input source="=quantity" target="quanitity" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S1</bpmn:incoming>
      <bpmn:outgoing>Flow_S2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="StartEvent_Sys_ListingReceived" name="Receive product listing request">
      <bpmn:outgoing>Flow_S1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_S_Start" messageRef="Message_3sau35u" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_Stk_ZeroCheck" name="Remaining stock == 0?">
      <bpmn:incoming>Flow_Stk4</bpmn:incoming>
      <bpmn:outgoing>Flow_Stk_IsZero</bpmn:outgoing>
      <bpmn:outgoing>Flow_Stk_NotZero</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Stk_Decrement" name="Decrement inventory count by ordered amount">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="decrement-inventory" />
        <zeebe:ioMapping>
          <zeebe:input source="=productId" target="productId" />
          <zeebe:input source="=orderedQuantity" target="orderedQuantity" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Stk3</bpmn:incoming>
      <bpmn:outgoing>Flow_Stk4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_Sys_OrderPlaced" name="Customer order placed">
      <bpmn:incoming>Flow_N1</bpmn:incoming>
      <bpmn:outgoing>Flow_Stk3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_S_Order" messageRef="Message_0ssn38m" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_Stk_SetAvailable" name="Set initial status to Available">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="set-product-available" />
        <zeebe:ioMapping>
          <zeebe:input source="=productId" target="productId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Stk_InitYes</bpmn:incoming>
      <bpmn:outgoing>Flow_Stk1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Stk_InitialCheck" name="Stock &#62; 0 &#38; within seasonal period?">
      <bpmn:incoming>Flow_S5</bpmn:incoming>
      <bpmn:outgoing>Flow_Stk_InitYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Stk_InitNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_Notif_SendRejected" name="Send listing rejected notification">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-listing-rejected" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A_Fail</bpmn:incoming>
      <bpmn:incoming>Flow_S_ApiFail</bpmn:incoming>
      <bpmn:outgoing>Flow_N_RejEnd</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_Sys_Rejected" name="Listing rejected">
      <bpmn:incoming>Flow_N_RejEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_Notif_SendListed" name="Send product listed notification">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-product-listed" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S6</bpmn:incoming>
      <bpmn:outgoing>Flow_N1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_Sys_SeasonEnd" name="Product remains active">
      <bpmn:incoming>Flow_Stk_NotZero</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_Notif_SendDepleted" name="Send Stock depleted notification to producer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-stock-depleted" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Stk5</bpmn:incoming>
      <bpmn:outgoing>Flow_N2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_Notif_SendReactivated" name="Send product status update to producer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-product-status-update" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Stk7</bpmn:incoming>
      <bpmn:incoming>Flow_Stk8</bpmn:incoming>
      <bpmn:incoming>Flow_0pv785e</bpmn:incoming>
      <bpmn:outgoing>Flow_N3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_Sys_Completed" name="Inventory cycle complete">
      <bpmn:incoming>Flow_N3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_Stk_SeasonEndCheck" name="Current date &#60;= seasonal end date &#38; stock &#62; 0?">
      <bpmn:incoming>Flow_1mhj75h</bpmn:incoming>
      <bpmn:outgoing>Flow_Stk_ReactivateYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Stk_SeasonExpired</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Stk_Reactivate" name="Reactivate status to Available &#38; restore public listing">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reactivate-product" />
        <zeebe:ioMapping>
          <zeebe:input source="=productId" target="productId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Stk_ReactivateYes</bpmn:incoming>
      <bpmn:outgoing>Flow_Stk7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Stk_SetSeasonExpired" name="Set status to Unavailable (Season Expired)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mark-season-expired" />
        <zeebe:ioMapping>
          <zeebe:input source="=productId" target="productId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Stk_SeasonExpired</bpmn:incoming>
      <bpmn:outgoing>Flow_Stk8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0swcidw" name="Keep status as Unavailable (Out of Stock) &#38; hide from store">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="Stay-out-of-stock" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_13b86jj</bpmn:incoming>
      <bpmn:outgoing>Flow_0pv785e</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_1y0dlrk" name="Await response/ timeout">
      <bpmn:incoming>Flow_11czauv</bpmn:incoming>
      <bpmn:outgoing>Flow_1ezjrq5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0r1uopx" messageRef="Message_1aj9gga" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_1q1iina" name="Verification result received?">
      <bpmn:incoming>Flow_1ezjrq5</bpmn:incoming>
      <bpmn:outgoing>Flow_07x35dj</bpmn:outgoing>
      <bpmn:outgoing>Flow_0myujez</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Sys_CertApproved" name="Certification valid?">
      <bpmn:incoming>Flow_07x35dj</bpmn:incoming>
      <bpmn:outgoing>Flow_S_ApiFail</bpmn:outgoing>
      <bpmn:outgoing>Flow_S_ApiPass</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Stk6" sourceRef="Event_Sys_StockUpdateReceived" targetRef="Gateway_0b8uggz" />
    <bpmn:sequenceFlow id="Flow_13b86jj" name="No" sourceRef="Gateway_0b8uggz" targetRef="Activity_0swcidw">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=restockForm == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1mhj75h" name="Yes" sourceRef="Gateway_0b8uggz" targetRef="Gateway_Stk_SeasonEndCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=restockFrom == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_N2" sourceRef="Task_Notif_SendDepleted" targetRef="Event_Sys_StockUpdateReceived" />
    <bpmn:sequenceFlow id="Flow_S_YesOrganic" name="Yes" sourceRef="Gateway_Sys_OrganicClaimed" targetRef="Task_Sys_SendVerifyReq">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=certificationClaimed=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11czauv" sourceRef="Task_Sys_SendVerifyReq" targetRef="Event_1y0dlrk" />
    <bpmn:sequenceFlow id="Flow_A1" sourceRef="Task_Admin_ManualReview" targetRef="Gateway_Admin_Approved" />
    <bpmn:sequenceFlow id="Flow_A_Pass" name="Yes" sourceRef="Gateway_Admin_Approved" targetRef="Task_Sys_WriteRecord">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=adminApproved=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A_Fail" name="No" sourceRef="Gateway_Admin_Approved" targetRef="Task_Notif_SendRejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=adminApproved=false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Stk_InitNo" name="No" sourceRef="Gateway_Stk_InitialCheck" targetRef="Task_Stk_SetUnavailableInit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=quantity &lt;= 0 or seasonalValid = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Stk2" sourceRef="Task_Stk_SetUnavailableInit" targetRef="Task_Sys_IndexPublish" />
    <bpmn:sequenceFlow id="Flow_S_ApiPass" name="Yes" sourceRef="Gateway_Sys_CertApproved" targetRef="Task_Sys_WriteRecord">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=certificationValid=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S_NoOrganic" name="No" sourceRef="Gateway_Sys_OrganicClaimed" targetRef="Task_Sys_WriteRecord">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=certificationClaimed=false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S5" sourceRef="Task_Sys_WriteRecord" targetRef="Gateway_Stk_InitialCheck" />
    <bpmn:sequenceFlow id="Flow_Stk_IsZero" name="Yes" sourceRef="Gateway_Stk_ZeroCheck" targetRef="Task_Stk_SetOutOfStock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=remainingStock = 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Stk5" sourceRef="Task_Stk_SetOutOfStock" targetRef="Task_Notif_SendDepleted" />
    <bpmn:sequenceFlow id="Flow_S_Valid" name="Yes" sourceRef="Gateway_Sys_ValidData" targetRef="Gateway_Sys_OrganicClaimed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=validationPassed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Stk1" sourceRef="Task_Stk_SetAvailable" targetRef="Task_Sys_IndexPublish" />
    <bpmn:sequenceFlow id="Flow_S6" sourceRef="Task_Sys_IndexPublish" targetRef="Task_Notif_SendListed" />
    <bpmn:sequenceFlow id="Flow_0myujez" name="No" sourceRef="Gateway_1q1iina" targetRef="Task_Admin_ManualReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=verificationResult == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S2" sourceRef="Task_Sys_ValidatePayload" targetRef="Gateway_Sys_ValidData" />
    <bpmn:sequenceFlow id="Flow_S_Invalid" name="No" sourceRef="Gateway_Sys_ValidData" targetRef="Task_Sys_DisplayErrors">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=validationPassed=false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S1" sourceRef="StartEvent_Sys_ListingReceived" targetRef="Task_Sys_ValidatePayload" />
    <bpmn:sequenceFlow id="Flow_Stk4" sourceRef="Task_Stk_Decrement" targetRef="Gateway_Stk_ZeroCheck" />
    <bpmn:sequenceFlow id="Flow_Stk_NotZero" name="No" sourceRef="Gateway_Stk_ZeroCheck" targetRef="EndEvent_Sys_SeasonEnd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=remainingStock != 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Stk3" sourceRef="Event_Sys_OrderPlaced" targetRef="Task_Stk_Decrement" />
    <bpmn:sequenceFlow id="Flow_N1" sourceRef="Task_Notif_SendListed" targetRef="Event_Sys_OrderPlaced" />
    <bpmn:sequenceFlow id="Flow_Stk_InitYes" name="Yes" sourceRef="Gateway_Stk_InitialCheck" targetRef="Task_Stk_SetAvailable">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=quantity &gt; 0 and seasonalValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S_ApiFail" name="No" sourceRef="Gateway_Sys_CertApproved" targetRef="Task_Notif_SendRejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=certificationValid=false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_N_RejEnd" sourceRef="Task_Notif_SendRejected" targetRef="EndEvent_Sys_Rejected" />
    <bpmn:sequenceFlow id="Flow_Stk8" sourceRef="Task_Stk_SetSeasonExpired" targetRef="Task_Notif_SendReactivated" />
    <bpmn:sequenceFlow id="Flow_Stk7" sourceRef="Task_Stk_Reactivate" targetRef="Task_Notif_SendReactivated" />
    <bpmn:sequenceFlow id="Flow_0pv785e" sourceRef="Activity_0swcidw" targetRef="Task_Notif_SendReactivated" />
    <bpmn:sequenceFlow id="Flow_N3" sourceRef="Task_Notif_SendReactivated" targetRef="EndEvent_Sys_Completed" />
    <bpmn:sequenceFlow id="Flow_Stk_SeasonExpired" name="No" sourceRef="Gateway_Stk_SeasonEndCheck" targetRef="Task_Stk_SetSeasonExpired">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=currentDate &gt; seasonalEndDate or remainingStock &lt;= 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Stk_ReactivateYes" name="Yes" sourceRef="Gateway_Stk_SeasonEndCheck" targetRef="Task_Stk_Reactivate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=currentDate &lt;= seasonalEndDate and remainingStock &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1ezjrq5" sourceRef="Event_1y0dlrk" targetRef="Gateway_1q1iina" />
    <bpmn:sequenceFlow id="Flow_07x35dj" name="Yes" sourceRef="Gateway_1q1iina" targetRef="Gateway_Sys_CertApproved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=verificationResult == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="Process_Customer" name="Customer Process" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Cust" name="Browse marketplace">
      <bpmn:outgoing>Flow_C1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Cust_SearchView" name="Search marketplace catalogue &#38; view product details">
      <bpmn:incoming>Flow_C1</bpmn:incoming>
      <bpmn:outgoing>Flow_C2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Cust_AddCart" name="Add product/s to shopping cart">
      <bpmn:incoming>Flow_C2</bpmn:incoming>
      <bpmn:outgoing>Flow_C3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_Cust_Checkout" name="Complete checkout &#38; place order">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="complete-checkout" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_C3</bpmn:incoming>
      <bpmn:outgoing>Flow_C4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_Cust" name="Order placed">
      <bpmn:incoming>Flow_C4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_C1" sourceRef="StartEvent_Cust" targetRef="Task_Cust_SearchView" />
    <bpmn:sequenceFlow id="Flow_C2" sourceRef="Task_Cust_SearchView" targetRef="Task_Cust_AddCart" />
    <bpmn:sequenceFlow id="Flow_C3" sourceRef="Task_Cust_AddCart" targetRef="Task_Cust_Checkout" />
    <bpmn:sequenceFlow id="Flow_C4" sourceRef="Task_Cust_Checkout" targetRef="EndEvent_Cust" />
  </bpmn:process>
  <bpmn:process id="Process_ExternalOrganic" name="External Organic Verification Service" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Ext_ReceiveReq" name="Receive organic certification claim">
      <bpmn:outgoing>Flow_E1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_E_Start" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Ext_CheckDB" name="Verify organic certification">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="verify-organic-certificate" />
        <zeebe:ioMapping>
          <zeebe:input source="=certificateNumber" target="certificateNumber" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_E1</bpmn:incoming>
      <bpmn:outgoing>Flow_E2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Ext_Error" name="Notify service unavailable">
      <bpmn:incoming>Flow_E_Err</bpmn:incoming>
      <bpmn:messageEventDefinition id="MsgDef_E_EndErr" />
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Ext_Success" name="Send verification result">
      <bpmn:incoming>Flow_E2</bpmn:incoming>
      <bpmn:messageEventDefinition id="MsgDef_E_EndOk" />
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="BoundaryEvent_Ext_Timeout" name="Connection timeout / network failure" attachedToRef="Task_Ext_CheckDB">
      <bpmn:outgoing>Flow_E_Err</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_E_Timeout" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_E1" sourceRef="StartEvent_Ext_ReceiveReq" targetRef="Task_Ext_CheckDB" />
    <bpmn:sequenceFlow id="Flow_E2" sourceRef="Task_Ext_CheckDB" targetRef="EndEvent_Ext_Success" />
    <bpmn:sequenceFlow id="Flow_E_Err" sourceRef="BoundaryEvent_Ext_Timeout" targetRef="EndEvent_Ext_Error" />
  </bpmn:process>
