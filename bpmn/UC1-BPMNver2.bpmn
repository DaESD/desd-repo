  <bpmn:collaboration id="Collaboration_UC1" name="usecase1ver4">
    <bpmn:participant id="Participant_Marketplace" name="Bristol regional food network" processRef="Process_UC1" />
    <bpmn:participant id="Participant_0z82ce8" name="Local food producer" />
    <bpmn:participant id="Participant_0rd1foi" name="External Organic Verification Service" processRef="Process_1d13jvg" />
    <bpmn:messageFlow id="Flow_0nvnz61" sourceRef="Activity_1h7dp6e" targetRef="Task_VerifyOrganicCert" />
    <bpmn:messageFlow id="Flow_17o6g0b" sourceRef="Task_VerifyOrganicCert" targetRef="Activity_1h7dp6e" />
    <bpmn:messageFlow id="Flow_11k54vn" sourceRef="Task_VerifyOrganicCert" targetRef="Task_NotifyVerificationError" />
    <bpmn:messageFlow id="Flow_0czg282" name="Product details" sourceRef="Participant_0z82ce8" targetRef="StartEvent_ProductSubmission" />
  </bpmn:collaboration>
  <bpmn:process id="Process_UC1" name="Producer Product Listing and Inventory Management" isExecutable="true">
    <bpmn:laneSet id="LaneSet_UC1">
      <bpmn:lane id="Lane_StockManagement" name="Stock Management">
        <bpmn:flowNodeRef>Task_SetStatusAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetStatusUnavailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckStockAndSeason</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_StockChanged</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Marketplace" name="Main Marketplace System">
        <bpmn:flowNodeRef>StartEvent_ProductSubmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitProductDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateSubmittedData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DataValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CorrectProductDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HasOrganicCert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateStockAndAvailability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PublishProduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CertValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ListingTerminated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1h7dp6e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0gm5py4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyVerificationError</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_ProductSubmission" name="Listing Requested">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_SubmitProductDetails" name="Submit product information">
      <bpmn:incoming>Flow_Corrected</bpmn:incoming>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ValidateSubmittedData" name="Validate mandatory product data">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_DataValid" name="Data valid &#38; complete?">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_DataInvalid</bpmn:outgoing>
      <bpmn:outgoing>Flow_DataValidYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CorrectProductDetails" name="Prompt producer to correct details">
      <bpmn:incoming>Flow_DataInvalid</bpmn:incoming>
      <bpmn:outgoing>Flow_Corrected</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_HasOrganicCert" name="Organic certification claimed?">
      <bpmn:incoming>Flow_DataValidYes</bpmn:incoming>
      <bpmn:outgoing>Flow_NoCert</bpmn:outgoing>
      <bpmn:outgoing>Flow_16m1wie</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_UpdateStockAndAvailability" name="Update product quantity &#38; seasonal availability">
      <bpmn:incoming>Flow_Published</bpmn:incoming>
      <bpmn:incoming>Flow_Loop2</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_PublishProduct" name="Publish product to marketplace">
      <bpmn:incoming>Flow_NoCert</bpmn:incoming>
      <bpmn:incoming>Flow_CertValidYes</bpmn:incoming>
      <bpmn:outgoing>Flow_Published</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_CertValid" name="Certification valid?">
      <bpmn:incoming>Flow_03zoiyu</bpmn:incoming>
      <bpmn:outgoing>Flow_CertValidYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_CertInvalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_ListingTerminated" name="Listing rejected or deferred">
      <bpmn:incoming>Flow_FailEnd</bpmn:incoming>
      <bpmn:incoming>Flow_CertInvalid</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_SetStatusAvailable" name="Set product status to &#39;Available&#39;">
      <bpmn:incoming>Flow_Available</bpmn:incoming>
      <bpmn:outgoing>Flow_08zxkrd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SetStatusUnavailable" name="Set product status to &#39;Unavailable&#39;">
      <bpmn:incoming>Flow_Unavailable</bpmn:incoming>
      <bpmn:outgoing>Flow_Loop2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_CheckStockAndSeason" name="Stock &#62; 0 AND within seasonal period?">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_Available</bpmn:outgoing>
      <bpmn:outgoing>Flow_Unavailable</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_StockChanged" name="Stock or season state change triggered">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Activity_1h7dp6e" name="Contact external organic verification service">
      <bpmn:incoming>Flow_16m1wie</bpmn:incoming>
      <bpmn:outgoing>Flow_03zoiyu</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_0gm5py4" name="Product listed">
      <bpmn:incoming>Flow_08zxkrd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_NotifyVerificationError" name="Notify producer of verification system error / unverified status">
      <bpmn:outgoing>Flow_FailEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_ProductSubmission" targetRef="Task_SubmitProductDetails" />
    <bpmn:sequenceFlow id="Flow_Corrected" sourceRef="Task_CorrectProductDetails" targetRef="Task_SubmitProductDetails" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SubmitProductDetails" targetRef="Task_ValidateSubmittedData" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ValidateSubmittedData" targetRef="Gateway_DataValid" />
    <bpmn:sequenceFlow id="Flow_DataInvalid" name="No" sourceRef="Gateway_DataValid" targetRef="Task_CorrectProductDetails" />
    <bpmn:sequenceFlow id="Flow_DataValidYes" name="Yes" sourceRef="Gateway_DataValid" targetRef="Gateway_HasOrganicCert" />
    <bpmn:sequenceFlow id="Flow_NoCert" name="No" sourceRef="Gateway_HasOrganicCert" targetRef="Task_PublishProduct" />
    <bpmn:sequenceFlow id="Flow_16m1wie" sourceRef="Gateway_HasOrganicCert" targetRef="Activity_1h7dp6e" />
    <bpmn:sequenceFlow id="Flow_Published" sourceRef="Task_PublishProduct" targetRef="Task_UpdateStockAndAvailability" />
    <bpmn:sequenceFlow id="Flow_Loop2" sourceRef="Task_SetStatusUnavailable" targetRef="Task_UpdateStockAndAvailability" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_UpdateStockAndAvailability" targetRef="Event_StockChanged" />
    <bpmn:sequenceFlow id="Flow_CertValidYes" name="Yes" sourceRef="Gateway_CertValid" targetRef="Task_PublishProduct" />
    <bpmn:sequenceFlow id="Flow_03zoiyu" sourceRef="Activity_1h7dp6e" targetRef="Gateway_CertValid" />
    <bpmn:sequenceFlow id="Flow_CertInvalid" name="No" sourceRef="Gateway_CertValid" targetRef="EndEvent_ListingTerminated" />
    <bpmn:sequenceFlow id="Flow_FailEnd" sourceRef="Task_NotifyVerificationError" targetRef="EndEvent_ListingTerminated" />
    <bpmn:sequenceFlow id="Flow_Available" name="Yes" sourceRef="Gateway_CheckStockAndSeason" targetRef="Task_SetStatusAvailable" />
    <bpmn:sequenceFlow id="Flow_08zxkrd" sourceRef="Task_SetStatusAvailable" targetRef="Event_0gm5py4" />
    <bpmn:sequenceFlow id="Flow_Unavailable" name="No" sourceRef="Gateway_CheckStockAndSeason" targetRef="Task_SetStatusUnavailable" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Event_StockChanged" targetRef="Gateway_CheckStockAndSeason" />
  </bpmn:process>
